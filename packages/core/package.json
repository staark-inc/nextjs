{
  "name": "@staark/core",
  "version": "0.1.0",
  "description": "Low-level Staark contracts, signed Hub protocol, content client primitives and shared security contracts.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./sign": "./src/hub/sign.ts",
    "./storage": "./src/storage/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "@aws-sdk/client-s3": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
