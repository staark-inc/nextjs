 }
+
+/* ── Theme editor ── */
+.sa-theme-grid--compact {
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  margin-bottom: 22px;
+}
+.sa-theme-grid--compact .sa-theme-card {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 18px;
+}
+.sa-theme-grid--compact .sa-theme-card__header {
+  align-items: flex-start;
+  justify-content: space-between;
+}
+.sa-theme-grid--compact .sa-theme-card__header h3 { margin-bottom: 2px; }
+.sa-theme-grid--compact .sa-theme-card__desc { margin: 0; min-height: 40px; }
+.sa-theme-grid--compact .sa-theme-card__presets { margin: 0; }
+.sa-theme-grid--compact .sa-theme-card > .sa-btn { align-self: flex-start; margin-top: auto; }
+
+.sa-theme-editor {
+  overflow: hidden;
+  border: 1px solid var(--sa-line);
+  border-radius: var(--sa-radius);
+  background: var(--sa-surface);
+}
+.sa-theme-editor__head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 28px;
+  padding: 22px 24px;
+  border-bottom: 1px solid var(--sa-line);
+}
+.sa-theme-editor__head h2 { margin: 3px 0 5px; font-size: 20px; }
+.sa-theme-editor__head p:last-child { margin: 0; color: var(--sa-muted); font-size: 12.5px; }
+.sa-kicker {
+  margin: 0;
+  color: var(--sa-primary);
+  font-size: 10.5px;
+  font-weight: 800;
+  letter-spacing: .11em;
+  text-transform: uppercase;
+}
+.sa-theme-editor__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
+
+.sa-theme-editor__preset {
+  display: grid;
+  grid-template-columns: minmax(280px, .75fr) minmax(360px, 1.25fr);
+  gap: 24px;
+  align-items: end;
+  padding: 20px 24px;
+  background: var(--sa-surface-soft);
+  border-bottom: 1px solid var(--sa-line);
+}
+.sa-theme-editor__preset .sa-field { margin: 0; }
+.sa-theme-preview-strip {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  overflow: hidden;
+  border: 1px solid var(--sa-line);
+  border-radius: 9px;
+  background: #fff;
+}
+.sa-theme-preview-strip > div {
+  min-width: 0;
+  padding: 8px;
+  border-right: 1px solid var(--sa-line);
+}
+.sa-theme-preview-strip > div:last-child { border-right: 0; }
+.sa-theme-preview-strip span {
+  display: block;
+  height: 28px;
+  margin-bottom: 6px;
+  border: 1px solid rgba(15, 23, 42, .1);
+  border-radius: 5px;
+}
+.sa-theme-preview-strip small {
+  display: block;
+  overflow: hidden;
+  color: var(--sa-muted);
+  font-size: 10px;
+  font-weight: 700;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.sa-theme-editor__tabs {
+  display: flex;
+  gap: 2px;
+  padding: 8px 16px 0;
+  overflow-x: auto;
+  border-bottom: 1px solid var(--sa-line);
+  background: #fff;
+  scrollbar-width: none;
+}
+.sa-theme-editor__tabs::-webkit-scrollbar { display: none; }
+.sa-theme-editor__tabs button {
+  flex: 0 0 auto;
+  padding: 10px 12px 11px;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  background: transparent;
+  color: var(--sa-muted);
+  font: inherit;
+  font-size: 12px;
+  font-weight: 700;
+  cursor: pointer;
+}
+.sa-theme-editor__tabs button:hover { color: var(--sa-ink); }
+.sa-theme-editor__tabs button.is-active {
+  border-bottom-color: var(--sa-primary);
+  color: var(--sa-primary);
+}
+
+.sa-theme-editor__body { min-height: 240px; padding: 22px 24px 8px; }
+.sa-theme-color-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 12px;
+}
+.sa-theme-color-field {
+  display: grid;
+  gap: 7px;
+  padding: 12px;
+  border: 1px solid var(--sa-line);
+  border-radius: 8px;
+  background: #fff;
+}
+.sa-theme-color-field__label { font-size: 12px; font-weight: 700; }
+.sa-theme-color-field__control {
+  display: grid;
+  grid-template-columns: 38px minmax(0, 1fr);
+  gap: 8px;
+  align-items: center;
+}
+.sa-theme-color-field input[type="color"] {
+  width: 38px;
+  height: 36px;
+  padding: 2px;
+  border: 1px solid var(--sa-line-strong);
+  border-radius: 6px;
+  background: #fff;
+  cursor: pointer;
+}
+.sa-theme-color-field input[type="text"] {
+  width: 100%;
+  min-width: 0;
+  height: 36px;
+  padding: 7px 9px;
+  border: 1px solid var(--sa-line);
+  border-radius: 6px;
+  background: #fff;
+  color: var(--sa-ink);
+  font: inherit;
+  font-size: 12px;
+  font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
+}
+.sa-theme-color-field input:focus { outline: 2px solid var(--sa-primary); outline-offset: 1px; }
+
+.sa-theme-editor__footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 13px 24px;
+  border-top: 1px solid var(--sa-line);
+  background: var(--sa-surface-soft);
+  color: var(--sa-muted);
+  font-size: 11px;
+}
+
+@media (max-width: 900px) {
+  .sa-theme-editor__head { flex-direction: column; }
+  .sa-theme-editor__actions { justify-content: flex-start; }
+  .sa-theme-editor__preset { grid-template-columns: 1fr; align-items: stretch; }
+}
+
+@media (max-width: 600px) {
+  .sa-theme-editor__head,
+  .sa-theme-editor__preset,
+  .sa-theme-editor__body { padding-right: 16px; padding-left: 16px; }
+  .sa-theme-editor__footer { align-items: flex-start; flex-direction: column; padding-right: 16px; padding-left: 16px; }
+  .sa-theme-preview-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .sa-theme-preview-strip > div:nth-child(2) { border-right: 0; }
+  .sa-theme-preview-strip > div:nth-child(-n+2) { border-bottom: 1px solid var(--sa-line); }
+  .sa-theme-color-grid { grid-template-columns: 1fr; }
+}
