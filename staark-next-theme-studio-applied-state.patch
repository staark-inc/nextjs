+function flattenTokens(tokens: ThemeOverrides): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const group of ["colors", "typography", "radius", "layout"] as const) {
+    for (const [key, value] of Object.entries(tokens[group] ?? {})) {
+      out[`${group}.${key}`] = value;
+    }
+  }
+  return out;
+}
+
+function countRecordChanges(
+  current: Record<string, string>,
+  next: Record<string, string>,
+): number {
+  const keys = new Set([...Object.keys(current), ...Object.keys(next)]);
+  let changed = 0;
+  for (const key of keys) {
+    if ((current[key] ?? "") !== (next[key] ?? "")) changed += 1;
+  }
+  return changed;
+}
