@@ -1065,3 +1065,216 @@ body :where(a, button, input, select, textarea):focus-visible {
   .sa-theme-preview-strip > div:nth-child(-n+2) { border-bottom: 1px solid var(--sa-line); }
   .sa-theme-color-grid { grid-template-columns: 1fr; }
 }
+
+/* ── Settings editor ───────────────────────────────────────────── */
+.sa-settings-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 22px;
+}
+.sa-settings-head .sa-subtitle { margin-bottom: 0; }
+.sa-settings-head__meta {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  color: var(--sa-muted);
+  font-size: 12px;
+}
+.sa-settings-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+  margin-bottom: 16px;
+}
+.sa-settings-panel {
+  margin-bottom: 16px;
+  padding: 22px;
+  border: 1px solid var(--sa-line);
+  border-radius: 10px;
+  background: #fff;
+}
+.sa-settings-grid > .sa-settings-panel { margin-bottom: 0; }
+.sa-settings-panel__head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 20px;
+  padding-bottom: 16px;
+  margin-bottom: 18px;
+  border-bottom: 1px solid var(--sa-line);
+}
+.sa-settings-panel__head h2 {
+  margin: 3px 0 0;
+  color: var(--sa-ink);
+  font-size: 16px;
+  line-height: 1.25;
+}
+.sa-settings-panel__head > p {
+  max-width: 460px;
+  margin: 0;
+  color: var(--sa-muted);
+  font-size: 12px;
+  text-align: right;
+}
+.sa-settings-kicker {
+  display: block;
+  color: var(--sa-primary);
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+}
+.sa-settings-fields {
+  display: grid;
+  gap: 0 14px;
+}
+.sa-settings-fields--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.sa-settings-field--wide { grid-column: 1 / -1; }
+.sa-settings-subsection {
+  padding-top: 18px;
+  margin-top: 4px;
+  border-top: 1px solid var(--sa-line);
+}
+.sa-settings-subsection--cta { margin-top: 22px; }
+.sa-settings-subsection__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 10px;
+}
+.sa-settings-subsection__head strong { display: block; font-size: 13px; }
+.sa-settings-subsection__head span {
+  display: block;
+  margin-top: 2px;
+  color: var(--sa-muted);
+  font-size: 11px;
+}
+.sa-settings-list { display: grid; gap: 8px; }
+.sa-settings-row {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
+  gap: 8px;
+  align-items: center;
+}
+.sa-settings-row--nav { grid-template-columns: 28px minmax(120px, .8fr) minmax(160px, 1.2fr) auto; }
+.sa-settings-row--link { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
+.sa-settings-row input {
+  width: 100%;
+  min-width: 0;
+  min-height: 38px;
+  padding: 8px 10px;
+  border: 1px solid var(--sa-line);
+  border-radius: 6px;
+  background: #fff;
+  color: var(--sa-ink);
+  font: inherit;
+  font-size: 12px;
+}
+.sa-settings-row input:focus { outline: 2px solid var(--sa-primary); outline-offset: 1px; border-color: transparent; }
+.sa-settings-row__handle {
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  border: 1px solid var(--sa-line);
+  border-radius: 6px;
+  color: var(--sa-muted);
+  font-size: 10px;
+  font-weight: 800;
+}
+.sa-settings-row__actions { display: flex; gap: 4px; }
+.sa-settings-icon-btn {
+  display: inline-grid;
+  place-items: center;
+  width: 30px;
+  height: 30px;
+  padding: 0;
+  border: 1px solid var(--sa-line);
+  border-radius: 6px;
+  background: #fff;
+  color: var(--sa-muted);
+  cursor: pointer;
+  font: inherit;
+}
+.sa-settings-icon-btn:hover:not(:disabled) { border-color: #bfdbfe; background: #eff6ff; color: var(--sa-primary); }
+.sa-settings-icon-btn:disabled { opacity: .35; cursor: default; }
+.sa-settings-icon-btn--danger:hover:not(:disabled) { border-color: #fecaca; background: #fef2f2; color: var(--sa-danger); }
+.sa-settings-empty {
+  padding: 12px;
+  border: 1px dashed var(--sa-line);
+  border-radius: 6px;
+  color: var(--sa-muted);
+  font-size: 12px;
+  text-align: center;
+}
+.sa-settings-nav-columns {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 20px;
+}
+.sa-settings-nav-editor {
+  min-width: 0;
+  padding: 16px;
+  border: 1px solid var(--sa-line);
+  border-radius: 8px;
+  background: var(--sa-surface-soft);
+}
+.sa-settings-advanced {
+  margin-bottom: 16px;
+  border: 1px solid var(--sa-line);
+  border-radius: 8px;
+  background: #fff;
+}
+.sa-settings-advanced > summary {
+  padding: 14px 18px;
+  cursor: pointer;
+  font-size: 12px;
+  font-weight: 700;
+  user-select: none;
+}
+.sa-settings-advanced__body {
+  padding: 0 18px 18px;
+  border-top: 1px solid var(--sa-line);
+}
+.sa-settings-advanced__body > p { margin: 14px 0 10px; color: var(--sa-muted); font-size: 12px; }
+.sa-settings-advanced__body .sa-json-editor { width: 100%; margin-bottom: 10px; }
+.sa-settings-savebar {
+  position: sticky;
+  bottom: 14px;
+  z-index: 8;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  padding: 12px 14px;
+  border: 1px solid var(--sa-line-strong);
+  border-radius: 9px;
+  background: #fff;
+}
+.sa-settings-savebar strong { display: block; font-size: 12px; }
+.sa-settings-savebar span { display: block; margin-top: 1px; color: var(--sa-muted); font-size: 11px; }
+
+@media (max-width: 1100px) {
+  .sa-settings-grid,
+  .sa-settings-nav-columns { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 700px) {
+  .sa-settings-head,
+  .sa-settings-panel__head,
+  .sa-settings-subsection__head,
+  .sa-settings-savebar { align-items: flex-start; flex-direction: column; }
+  .sa-settings-panel__head > p { text-align: left; }
+  .sa-settings-fields--two { grid-template-columns: 1fr; }
+  .sa-settings-field--wide { grid-column: auto; }
+  .sa-settings-row,
+  .sa-settings-row--link { grid-template-columns: 1fr; }
+  .sa-settings-row--nav { grid-template-columns: 28px minmax(0, 1fr); }
+  .sa-settings-row--nav > input { grid-column: 2; }
+  .sa-settings-row--nav .sa-settings-row__actions { grid-column: 2; }
+  .sa-settings-savebar { position: static; }
+  .sa-settings-savebar .sa-btn { width: 100%; justify-content: center; }
+}
