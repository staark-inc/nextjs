# Local Docker test: emails stay in Mailpit at http://localhost:8025.
# Copy to .env.docker. Generate a unique token secret before starting.
CUSTOM_FORMS_SECRET=
CUSTOM_SMTP_HOST=mailpit
CUSTOM_SMTP_PORT=1025
CUSTOM_SMTP_SECURE=false
# Unencrypted SMTP is confined to the local test network.
CUSTOM_SMTP_REQUIRE_TLS=false
CUSTOM_SMTP_USER=
CUSTOM_SMTP_PASSWORD=
CUSTOM_SMTP_FROM=studio@example.com
CUSTOM_CONTACT_TO=inbox@example.com
CUSTOM_FORMS_TRUST_PROXY=false
