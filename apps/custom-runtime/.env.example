# Shared code, independently selected project per runtime process.
# Leave unset to load ./project/staark.custom.json.
# STAARK_CUSTOM_PROJECTS_ROOT=/srv/staark/projects
# STAARK_CUSTOM_PROJECT_KEY=custom-demo

# Existing explicit sources take precedence over ROOT + KEY:
# STAARK_CUSTOM_PROJECT_DIR=/srv/staark/projects/custom-demo
# STAARK_CUSTOM_MANIFEST_PATH=/srv/staark/projects/custom-demo/staark.custom.json

# Example server-only API credential. No NEXT_PUBLIC_ prefix.
# CRM_API_TOKEN=

# Email forms (server-only). Generate: openssl rand -hex 32
CUSTOM_FORMS_SECRET=
CUSTOM_SMTP_HOST=
CUSTOM_SMTP_PORT=587
CUSTOM_SMTP_SECURE=false
CUSTOM_SMTP_REQUIRE_TLS=true
CUSTOM_SMTP_USER=
CUSTOM_SMTP_PASSWORD=
CUSTOM_SMTP_FROM=
CUSTOM_CONTACT_TO=
# Only true behind a proxy that replaces X-Real-IP and blocks direct access.
CUSTOM_FORMS_TRUST_PROXY=false
