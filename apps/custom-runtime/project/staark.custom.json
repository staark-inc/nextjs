{
  "schema": "staark-custom/v1",
  "project": {
    "key": "custom-demo",
    "name": "Staark Custom Demo",
    "version": "1.0.0"
  },
  "runtime": {
    "mode": "custom",
    "theme": {
      "family": "custom-base",
      "variant": "studio"
    },
    "overrides": {
      "components": false,
      "routes": true,
      "styles": false,
      "layouts": false,
      "navigation": true
    },
    "custom": {
      "componentNamespace": "custom-demo",
      "routeNamespace": "/custom",
      "allowCustomLayouts": true,
      "allowThemeExtensions": true
    },
    "modules": [
      {
        "key": "project-info"
      }
    ],
    "addons": [
      {
        "key": "project-label",
        "config": {
          "label": "Staark Custom Demo"
        }
      },
      {
        "key": "blog",
        "config": {
          "basePath": "/blog",
          "title": "Blog",
          "description": "Nyheter, id\u00e9er och inspiration fr\u00e5n Staark Custom Demo."
        }
      }
    ],
    "integrations": []
  }
}
