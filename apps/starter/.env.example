# Staark Hub / dev connector
# STAARK_HUB_URL=https://staarkinc.com
# STAARK_SITE_ID=your-site-id
# STAARK_SITE_SECRET=your-site-secret

# Content source: "hub" (default when id+secret set) or "fixtures"
STAARK_CONTENT_SOURCE=fixtures

# Active theme for this deploy: light | salong | gastfrihet | byra | webb
STAARK_THEME=salong

# Deployment / release identity.
# STAARK_DEPLOYMENT_ID may be omitted: a stable id is generated in persistent
# storage on first boot and survives container rebuilds.
# STAARK_DEPLOYMENT_ID=client-production-01
STAARK_UPDATE_CHANNEL=stable
STAARK_RELEASE_VERSION=0.1.0
STAARK_RELEASE_ID=local

# Secret used to sign public form tokens in fixtures mode (Hub secret is used when paired)
STAARK_FORM_SECRET=dev-form-secret-change-me

# Local /admin authentication. Development has safe convenience defaults.
# Production requires all three values and refuses to fall back to defaults.
# ADMIN_USERNAME=site-admin
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Support link shown on the admin login screen.
# STAARK_ADMIN_SUPPORT_EMAIL=support@staarkinc.com

# Reverse-proxy trust / Docker exposure.
# Docker defaults to loopback-only. If you deliberately expose the app directly
# on LAN/public interfaces, set STAARK_TRUST_PROXY=0.
# STAARK_BIND_HOST=127.0.0.1
# STAARK_TRUST_PROXY=1
