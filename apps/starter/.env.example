# Staark Hub / dev connector
# STAARK_HUB_URL=https://staarkinc.com
# STAARK_SITE_ID=your-site-id
# STAARK_SITE_SECRET=your-site-secret

# Content source: "hub" (default when id+secret set) or "fixtures"
STAARK_CONTENT_SOURCE=fixtures

# Active theme for this deploy: light | salong | gastfrihet
STAARK_THEME=salong

# Secret used to sign public form tokens in fixtures mode (Hub secret is used when paired)
STAARK_FORM_SECRET=dev-form-secret-change-me

# Local /admin authentication. Development has safe convenience defaults.
# Production requires all three values and refuses to fall back to defaults.
# ADMIN_USERNAME=site-admin
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
