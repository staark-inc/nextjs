+          {p.intro ? <p className="sk-section__intro">{p.intro}</p> : null}
+        </header>
+        <ul className="sk-areas">
+          {p.areas.map((area) => (
+            <li key={area} className="sk-area">
+              {area}
+            </li>
+          ))}
+        </ul>
+        {p.note ? <p className="sk-areas__note">{p.note}</p> : null}
+      </Container>
+    </section>
+  );
+};
