+/* Staark Admin v2 — visual layer only. Existing component classes stay compatible. */
+:root {
+  --sa-bg: #f4f6fa;
+  --sa-surface: #ffffff;
+  --sa-sidebar: #11131a;
+  --sa-sidebar-hover: rgba(255, 255, 255, 0.055);
+  --sa-sidebar-text: #a5abba;
+  --sa-sidebar-active: #ffffff;
+  --sa-ink: #171923;
+  --sa-muted: #717789;
+  --sa-line: #e6e8ef;
+  --sa-primary: #5b5cf0;
+  --sa-primary-hover: #4b4cdb;
+  --sa-primary-soft: rgba(91, 92, 240, 0.09);
+  --sa-danger: #d94252;
+  --sa-danger-soft: rgba(217, 66, 82, 0.09);
+  --sa-success: #168a63;
+  --sa-success-soft: rgba(22, 138, 99, 0.1);
+  --sa-warning: #bf7a12;
+  --sa-warning-soft: rgba(191, 122, 18, 0.1);
+  --sa-radius: 16px;
+  --sa-radius-sm: 10px;
+  --sa-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --sa-shadow: 0 1px 2px rgba(15, 23, 42, 0.035), 0 8px 24px rgba(15, 23, 42, 0.045);
+  --sa-shadow-lg: 0 20px 60px rgba(15, 23, 42, 0.14);
+}
+
+body {
+  min-width: 0;
+  background: var(--sa-bg);
+  color: var(--sa-ink);
+  font-family: var(--sa-font);
+  font-size: 14px;
+}
+
+.sa-shell--v2 {
+  display: grid;
+  grid-template-columns: 248px minmax(0, 1fr);
+  min-height: 100vh;
+  background: var(--sa-bg);
+}
+
+.sa-workspace {
+  min-width: 0;
+  min-height: 100vh;
+}
+
+.sa-sidebar--v2 {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  height: 100vh;
+  padding: 14px 12px 12px;
+  overflow-y: auto;
+  background:
+    radial-gradient(circle at 28px 24px, rgba(91, 92, 240, 0.16), transparent 180px),
+    #101219;
+  border-right: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.sa-sidebar__brand--v2 {
+  justify-content: space-between;
+  padding: 6px 8px 18px;
+  margin: 0;
+  border: 0;
+}
+
+.sa-brand {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  color: #fff;
+  text-decoration: none;
+}
+
+.sa-logo--v2 {
+  width: 36px;
+  height: 36px;
+  border-radius: 11px;
+  background: linear-gradient(145deg, #696aff, #4e4fe0);
+  box-shadow: 0 8px 24px rgba(91, 92, 240, 0.28);
+  font-size: 16px;
+}
+
+.sa-brand__copy { display: grid; gap: 1px; }
+.sa-brand__copy strong { font-size: 15px; letter-spacing: -0.01em; }
+.sa-brand__copy small { color: #777f91; font-size: 10px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.1em; }
+
+.sa-sidebar__close {
+  display: none;
+  width: 34px;
+  height: 34px;
+  place-items: center;
+  border: 0;
+  border-radius: 9px;
+  background: rgba(255, 255, 255, 0.06);
+  color: #fff;
+  font: inherit;
+  font-size: 22px;
+  cursor: pointer;
+}
+
+.sa-sidebar__section-label {
+  padding: 10px 12px 7px;
+  color: #606778;
+  font-size: 10px;
+  font-weight: 750;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+}
+
+.sa-nav--v2 {
+  display: grid;
+  gap: 3px;
+  padding: 0;
+  flex: 0;
+}
+
+.sa-nav--v2 li a.sa-nav__link {
+  position: relative;
+  display: grid;
+  grid-template-columns: 36px 1fr;
+  align-items: center;
+  gap: 2px;
+  min-height: 50px;
+  padding: 7px 10px;
+  margin: 0;
+  border: 1px solid transparent;
+  border-radius: 11px;
+  color: #8f96a7;
+  text-decoration: none;
+  transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+.sa-nav--v2 li a.sa-nav__link:hover {
+  background: rgba(255, 255, 255, 0.045);
+  color: #d7dbe5;
+}
+
+.sa-nav--v2 li a.sa-nav__link--active {
+  background: rgba(91, 92, 240, 0.13);
+  border-color: rgba(122, 123, 255, 0.16);
+  color: #fff;
+}
+
+.sa-nav--v2 li a.sa-nav__link--active::before {
+  content: "";
+  position: absolute;
+  left: -12px;
+  width: 3px;
+  height: 24px;
+  border-radius: 0 4px 4px 0;
+  background: #7778ff;
+  box-shadow: 0 0 16px rgba(119, 120, 255, 0.55);
+}
+
+.sa-nav__icon {
+  display: grid;
+  width: 30px;
+  height: 30px;
+  place-items: center;
+  border-radius: 8px;
+  color: #777f91;
+}
+
+.sa-nav__link--active .sa-nav__icon { color: #9e9fff; }
+.sa-nav__copy { display: grid; gap: 1px; }
+.sa-nav__copy strong { color: inherit; font-size: 13px; font-weight: 650; line-height: 1.2; }
+.sa-nav__copy small { color: #626a7b; font-size: 10.5px; line-height: 1.25; }
+.sa-nav__link--active .sa-nav__copy small { color: #858ca0; }
+.sa-sidebar__spacer { min-height: 24px; flex: 1; }
+
+.sa-sidebar__user--v2 {
+  margin: 0 2px 6px;
+  padding: 12px 10px;
+  border: 1px solid rgba(255, 255, 255, 0.055);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.025);
+}
+
+.sa-sidebar__user--v2 .sa-sidebar__avatar {
+  width: 34px;
+  height: 34px;
+  background: #262a36;
+  color: #dfe2ea;
+}
+
+.sa-sidebar__user-copy { min-width: 0; }
+.sa-sidebar__user-copy strong { display: block; overflow: hidden; color: #f7f8fa; font-size: 12.5px; text-overflow: ellipsis; white-space: nowrap; }
+.sa-sidebar__user-copy span { display: block; margin-top: 1px; color: #666e80; font-size: 10.5px; }
+
+.sa-sidebar__footer--v2 {
+  display: grid;
+  gap: 2px;
+  padding: 2px;
+}
+
+.sa-sidebar__footer--v2 a {
+  min-height: 38px;
+  padding: 8px 10px;
+  border-radius: 9px;
+  color: #7c8495;
+  font-size: 12px;
+}
+
+.sa-sidebar__footer--v2 a:hover { background: rgba(255, 255, 255, 0.045); color: #f7f8fb; }
+.sa-sidebar__footer--v2 a[data-logout]:hover { background: rgba(217, 66, 82, 0.08); color: #ff7b88; }
+
+.sa-topbar {
+  position: sticky;
+  top: 0;
+  z-index: 30;
+  display: flex;
+  height: 68px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 0 clamp(20px, 3vw, 42px);
+  border-bottom: 1px solid rgba(226, 229, 237, 0.9);
+  background: rgba(250, 251, 253, 0.9);
+  backdrop-filter: blur(14px);
+}
+
+.sa-topbar__context { display: grid; gap: 1px; }
+.sa-topbar__context span { color: #959bac; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; }
+.sa-topbar__context strong { color: #2b2e38; font-size: 13px; font-weight: 650; }
+.sa-topbar__actions { display: flex; align-items: center; gap: 10px; }
+.sa-topbar__pill { padding: 6px 9px; border: 1px solid #e3e6ee; border-radius: 999px; background: #fff; color: #777e8e; font-size: 10.5px; font-weight: 650; }
+.sa-topbar__site-link { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; color: #3f4350; font-size: 12px; font-weight: 650; text-decoration: none; }
+.sa-topbar__site-link:hover { color: var(--sa-primary); }
+
+.sa-mobile-menu {
+  display: none;
+  width: 38px;
+  height: 38px;
+  padding: 9px;
+  border: 1px solid var(--sa-line);
+  border-radius: 10px;
+  background: #fff;
+  cursor: pointer;
+}
+.sa-mobile-menu span { display: block; height: 1.5px; margin: 4px 0; border-radius: 4px; background: #383c48; }
+
+.sa-main--v2 { min-width: 0; padding: 34px clamp(20px, 3vw, 42px) 56px; }
+.sa-main__inner { width: min(100%, 1380px); margin: 0 auto; }
+
+.sa-h1 { margin: 0; color: #171923; font-size: clamp(27px, 3vw, 34px); font-weight: 730; letter-spacing: -0.035em; line-height: 1.08; }
+.sa-subtitle { max-width: 760px; margin: 8px 0 0; color: var(--sa-muted); font-size: 13.5px; line-height: 1.55; }
+.sa-page-eyebrow, .sa-card__eyebrow { display: block; margin-bottom: 6px; color: #8b91a0; font-size: 10px; font-weight: 760; text-transform: uppercase; letter-spacing: 0.1em; }
+
+.sa-page-header {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 28px;
+  margin-bottom: 28px;
+}
+.sa-page-header__actions { display: flex; flex-wrap: wrap; gap: 9px; }
+
+.sa-card, .sa-stat, .sa-theme-card {
+  border-color: #e5e7ee;
+  border-radius: 16px;
+  box-shadow: var(--sa-shadow);
+}
+
+.sa-card { padding: 22px; margin-bottom: 18px; }
+.sa-card > h3 { color: #7d8392; font-size: 10.5px; font-weight: 750; letter-spacing: 0.08em; }
+
+.sa-btn {
+  min-height: 38px;
+  justify-content: center;
+  padding: 8px 14px;
+  border-radius: 10px;
+  font-size: 12.5px;
+  font-weight: 650;
+  transition: transform 120ms ease, border-color 120ms ease, background 120ms ease, color 120ms ease;
+}
+.sa-btn:hover { transform: translateY(-1px); }
+.sa-btn--primary { background: #5556e8; box-shadow: 0 7px 18px rgba(85, 86, 232, 0.18); }
+.sa-btn--primary:hover { background: #494ad3; }
+.sa-btn--ghost { border-color: #e1e4eb; box-shadow: none; }
+.sa-btn--ghost:hover { border-color: #c9ccda; color: #272a34; }
+.sa-btn--sm { min-height: 30px; padding: 5px 10px; border-radius: 8px; font-size: 11.5px; }
+
+.sa-stats--dashboard { margin-bottom: 24px; }
+.sa-stats { gap: 14px; }
+.sa-stat--v2 { min-height: 142px; padding: 20px; }
+.sa-stat__topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.sa-stat__marker { width: 8px; height: 8px; border-radius: 50%; background: #5b5cf0; box-shadow: 0 0 0 5px rgba(91, 92, 240, 0.08); }
+.sa-stat__marker--green { background: #15956b; box-shadow: 0 0 0 5px rgba(21, 149, 107, 0.08); }
+.sa-stat__marker--violet { background: #8f60df; box-shadow: 0 0 0 5px rgba(143, 96, 223, 0.08); }
+.sa-stat__marker--amber { background: #c9871f; box-shadow: 0 0 0 5px rgba(201, 135, 31, 0.08); }
+.sa-stat__value { margin-top: 17px; font-size: 31px; font-weight: 730; letter-spacing: -0.04em; }
+.sa-stat__value--sm { overflow: hidden; font-size: 19px; text-overflow: ellipsis; white-space: nowrap; }
+.sa-stat__desc { margin-top: 5px; color: #8b91a0; font-size: 11.5px; }
+
+.sa-dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr); gap: 18px; align-items: start; }
+.sa-dashboard-panel { padding: 0; overflow: hidden; }
+.sa-dashboard-side { display: grid; gap: 18px; }
+.sa-dashboard-side .sa-card { margin-bottom: 0; }
+
+.sa-card__header {
+  display: flex;
+  min-height: 76px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 17px 20px;
+  border-bottom: 1px solid #eceef3;
+}
+.sa-card__header--compact { min-height: 0; padding: 0 0 15px; }
+.sa-card__header h2 { margin: 0; font-size: 16px; font-weight: 700; letter-spacing: -0.02em; }
+.sa-card__header a { display: inline-flex; align-items: center; gap: 7px; color: var(--sa-primary); font-size: 11.5px; font-weight: 650; text-decoration: none; }
+.sa-card__header a:hover { color: var(--sa-primary-hover); }
+
+.sa-dashboard-pages { display: grid; }
+.sa-dashboard-page {
+  display: grid;
+  grid-template-columns: 38px minmax(0, 1fr) 18px;
+  align-items: center;
+  gap: 12px;
+  min-height: 64px;
+  padding: 9px 20px;
+  border-bottom: 1px solid #f0f1f5;
+  color: #3d414d;
+  text-decoration: none;
+  transition: background 120ms ease;
+}
+.sa-dashboard-page:last-child { border-bottom: 0; }
+.sa-dashboard-page:hover { background: #fafafe; }
+.sa-dashboard-page > svg { color: #a2a7b4; transition: transform 120ms ease, color 120ms ease; }
+.sa-dashboard-page:hover > svg { color: var(--sa-primary); transform: translateX(2px); }
+.sa-dashboard-page__icon { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid #e5e7ee; border-radius: 10px; background: #f8f9fc; color: #707787; font-size: 11px; font-weight: 750; }
+.sa-dashboard-page__copy { min-width: 0; }
+.sa-dashboard-page__copy strong { display: block; overflow: hidden; color: #2f323c; font-size: 12.5px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; text-transform: capitalize; }
+.sa-dashboard-page__copy small { display: block; margin-top: 2px; overflow: hidden; color: #9aa0ad; font-size: 10.5px; text-overflow: ellipsis; white-space: nowrap; }
+
+.sa-deployment-card {
+  padding: 22px;
+  border: 1px solid #20232e;
+  border-radius: 16px;
+  background: linear-gradient(150deg, #171923 0%, #11131a 100%);
+  box-shadow: 0 18px 44px rgba(17, 19, 26, 0.14);
+  color: #fff;
+}
+.sa-deployment-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
+.sa-deployment-card .sa-card__eyebrow { color: #6f7789; }
+.sa-deployment-card h2 { margin: 0; font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }
+.sa-deployment-card p { margin: 14px 0 18px; color: #9299a9; font-size: 12px; line-height: 1.6; }
+.sa-source-dot { width: 10px; height: 10px; margin-top: 5px; border-radius: 50%; background: #d69a32; box-shadow: 0 0 0 5px rgba(214, 154, 50, 0.1); }
+.sa-source-dot--hub { background: #35b584; box-shadow: 0 0 0 5px rgba(53, 181, 132, 0.1); }
+.sa-deployment-meta { display: grid; gap: 9px; margin: 0; }
+.sa-deployment-meta div { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-top: 9px; border-top: 1px solid rgba(255, 255, 255, 0.065); }
+.sa-deployment-meta dt { color: #666e80; font-size: 10.5px; }
+.sa-deployment-meta dd { margin: 0; overflow: hidden; color: #ced2db; font-size: 10.5px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
+
+.sa-shortcuts { padding: 20px; }
+.sa-shortcut-list { display: grid; }
+.sa-shortcut-list a {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 18px;
+  gap: 2px 10px;
+  align-items: center;
+  padding: 11px 0;
+  border-bottom: 1px solid #eef0f4;
+  color: #383c47;
+  text-decoration: none;
+}
+.sa-shortcut-list a:last-child { border-bottom: 0; padding-bottom: 0; }
+.sa-shortcut-list a:first-child { padding-top: 0; }
+.sa-shortcut-list a span { font-size: 12.5px; font-weight: 650; }
+.sa-shortcut-list a small { grid-column: 1; color: #969ca9; font-size: 10.5px; }
+.sa-shortcut-list a svg { grid-column: 2; grid-row: 1 / span 2; color: #afb4bf; }
+.sa-shortcut-list a:hover span, .sa-shortcut-list a:hover svg { color: var(--sa-primary); }
+
+/* Existing admin screens inherit the v2 surface language. */
+.sa-breadcrumb { margin-bottom: 16px; font-size: 11px; }
+.sa-breadcrumb a { color: #8b91a0; }
+.sa-breadcrumb span:last-child { color: #575c69; }
+.sa-toolbar { gap: 8px; }
+.sa-field label { margin-bottom: 7px; color: #555a67; font-size: 11.5px; font-weight: 650; }
+.sa-field input, .sa-field textarea, .sa-field select { min-height: 41px; border-color: #e0e3eb; border-radius: 10px; background: #fff; font-size: 13px; box-shadow: 0 1px 1px rgba(15, 23, 42, 0.02); }
+.sa-field input:focus, .sa-field textarea:focus, .sa-field select:focus { border-color: #8c8df6; box-shadow: 0 0 0 3px rgba(91, 92, 240, 0.08); }
+.sa-field-hint { color: #9399a7; font-size: 10.5px; }
+.sa-page-list li { min-height: 58px; padding: 12px 14px; }
+.sa-page-list li:hover { background: #fafafe; }
+.sa-page-list a { color: #343843; font-weight: 650; }
+.sa-page-list a:hover { color: var(--sa-primary); text-decoration: none; }
+.sa-page-list .sa-path { color: #9aa0ad; font-size: 10.5px; }
+.sa-table th { padding: 11px 14px; border-bottom-color: #e7e9ef; background: #fafbfc; color: #8b91a0; font-size: 10px; }
+.sa-table td { padding: 13px 14px; border-bottom-color: #eef0f4; }
+.sa-table tr:hover td { background: #fbfbfd; }
+.sa-tab-bar { max-width: 100%; overflow-x: auto; padding: 3px; background: #ebeef4; scrollbar-width: none; }
+.sa-tab-bar::-webkit-scrollbar { display: none; }
+.sa-tab { flex: 0 0 auto; min-height: 32px; white-space: nowrap; }
+.sa-tab--active { box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08); }
+.sa-theme-grid { gap: 14px; }
+.sa-theme-card { padding: 20px; }
+.sa-theme-card--active { border-color: #7778ef; box-shadow: 0 0 0 3px rgba(91, 92, 240, 0.07), var(--sa-shadow); }
+.sa-block { border-radius: 13px; box-shadow: none; }
+.sa-block__header { min-height: 54px; }
+.sa-dropzone { border-color: #d9dce6; border-radius: 14px; background: rgba(255, 255, 255, 0.55); }
+.sa-dropzone:hover, .sa-dropzone--active { border-color: #8c8df6; background: rgba(91, 92, 240, 0.045); }
+.sa-media-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; }
+.sa-media-item { border-radius: 13px; background: #fff; }
+.sa-media-item:hover { border-color: #a2a3f4; box-shadow: 0 0 0 3px rgba(91, 92, 240, 0.06); }
+.sa-seo-preview { border: 1px solid #e7e9ef; border-radius: 12px; background: #fbfbfc; }
+.sa-empty--compact { padding: 32px 20px; }
+
+.sa-login { background: radial-gradient(circle at 50% 0%, rgba(91, 92, 240, 0.08), transparent 34%), #f4f6fa; }
+.sa-login__card { max-width: 410px; padding: 38px; border: 1px solid #e4e6ed; border-radius: 18px; box-shadow: 0 24px 70px rgba(20, 24, 40, 0.09); }
+.sa-login__logo { width: 46px; height: 46px; border-radius: 13px; background: linear-gradient(145deg, #696aff, #4e4fe0); box-shadow: 0 12px 28px rgba(91, 92, 240, 0.24); }
+.sa-login__title { font-size: 23px; letter-spacing: -0.025em; }
+.sa-login__subtitle { color: #858b9a; }
+
+.sa-toast { border-radius: 12px; box-shadow: 0 16px 42px rgba(15, 23, 42, 0.18); }
+.sa-sidebar-backdrop { display: none; }
+
+@media (max-width: 1100px) {
+  .sa-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .sa-dashboard-grid { grid-template-columns: 1fr; }
+  .sa-dashboard-side { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 900px) {
+  .sa-shell--v2 { grid-template-columns: minmax(0, 1fr); }
+  .sa-sidebar--v2 {
+    position: fixed;
+    inset: 0 auto 0 0;
+    width: min(286px, 86vw);
+    height: 100dvh;
+    transform: translateX(-103%);
+    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
+    box-shadow: 22px 0 60px rgba(5, 8, 18, 0.22);
+  }
+  .sa-sidebar--v2.sa-sidebar--open { transform: translateX(0); }
+  .sa-sidebar__close { display: grid; }
+  .sa-sidebar__user--v2 { display: flex; }
+  .sa-sidebar__footer--v2 { display: grid; }
+  .sa-nav--v2 { display: grid; }
+  .sa-nav--v2 li a.sa-nav__link { padding: 7px 10px; font-size: inherit; }
+  .sa-nav--v2 li a.sa-nav__link svg { width: 18px; height: 18px; }
+  .sa-sidebar-backdrop {
+    position: fixed;
+    inset: 0;
+    z-index: 35;
+    display: block;
+    border: 0;
+    background: rgba(12, 15, 24, 0.42);
+    backdrop-filter: blur(2px);
+  }
+  .sa-mobile-menu { display: block; flex: 0 0 auto; }
+  .sa-topbar { height: 62px; padding: 0 16px; }
+  .sa-topbar__context { margin-right: auto; }
+  .sa-topbar__pill { display: none; }
+  .sa-main--v2 { padding: 24px 16px 44px; }
+  .sa-page-header { align-items: flex-start; flex-direction: column; gap: 18px; }
+  .sa-page-header__actions { width: 100%; }
+  .sa-page-header__actions .sa-btn { flex: 1; }
+}
+
+@media (max-width: 680px) {
+  .sa-dashboard-side { grid-template-columns: 1fr; }
+  .sa-card { padding: 17px; }
+  .sa-inline-form { align-items: stretch; flex-direction: column; }
+  .sa-inline-form .sa-field { width: 100%; }
+  .sa-page-list li { align-items: flex-start; gap: 12px; flex-direction: column; }
+  .sa-page-list li > div:last-child { width: 100%; }
+  .sa-page-list li > div:last-child .sa-btn { flex: 1; }
+  .sa-toolbar { align-items: stretch; flex-wrap: wrap; }
+  .sa-toolbar--right { display: none; }
+  .sa-table { min-width: 680px; }
+  .sa-media-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 480px) {
+  .sa-topbar__site-link { padding-inline: 4px; font-size: 11px; }
+  .sa-topbar__context span { display: none; }
+  .sa-topbar__context strong { font-size: 12.5px; }
+  .sa-stats { grid-template-columns: 1fr; }
+  .sa-stat--v2 { min-height: 126px; }
+  .sa-media-grid { grid-template-columns: 1fr 1fr; gap: 9px; }
+  .sa-dashboard-page { padding-inline: 14px; }
+  .sa-login__card { padding: 30px 22px; }
+}
