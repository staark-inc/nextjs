{
  "name": "@staark/theme-light",
  "version": "0.1.0",
  "description": "S-Hub Light — the parent Next.js theme (Scandinavian / local-business presets, core sections).",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
