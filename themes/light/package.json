    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
